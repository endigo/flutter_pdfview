.DS_Store
.dart_tool/

.packages
.pub/
.idea/

# Pub workspaces resolve against a single lockfile at the workspace root, so
# member packages must not carry their own.
packages/**/pubspec.lock

build/

# Paths below moved under packages/ with the monorepo layout, so they are
# matched at any depth rather than anchored to the repository root.
**/ios/.symlinks
**/android/app/.cxx
**/ios/Flutter/flutter_export_environment.sh
**/.flutter-plugins-dependencies
